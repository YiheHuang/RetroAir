# RetroAir API 配置
# 说明：本文件只放占位符，不包含真实密钥。真实运行前请把 ADS_API_KEY 改成自己的 Copernicus ADS API Key。

# CAMS EAC4 数据下载需要 Copernicus Atmosphere Data Store (ADS) 账号与 API Key。
# 获取入口：https://ads.atmosphere.copernicus.eu/how-to-api
# 注意：还需要在 ADS 网页端接受 cams-global-reanalysis-eac4 数据集许可，否则即使 key 正确也会下载失败。
ADS_API_URL=https://ads.atmosphere.copernicus.eu/api
ADS_API_KEY=your_ads_uid:your_ads_api_key

# 以下数据源当前脚本不需要 API Key，保留字段仅用于说明与未来扩展。
NASA_POWER_API_KEY=
OPEN_METEO_API_KEY=
AKSHARE_API_KEY=
